{
  "name": "@tssuite/gg_dna-js",
  "version": "1.0.1",
  "description": "The gg_dna DNA engine compiled to WebAssembly — instantiates and verifies a project's DNA from TypeScript test runs.",
  "keywords": [
    "dna",
    "gg_dna",
    "dart",
    "wasm",
    "webassembly",
    "bridge",
    "typescript",
    "vitest"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "node": "./dist/index.node.js",
      "default": "./dist/index.js"
    },
    "./wasm": "./dist/bridge-wasm.wasm"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-version": "dart run scripts/sync_version.dart",
    "build:dart": "dart run build.dart",
    "build:dart:debug": "dart run build.dart --debug",
    "build:ts": "tsc -p tsconfig.json && vite build && cp typescript/generated/bridge-wasm.wasm dist/bridge-wasm.wasm && rm -rf dist/base-dna && cp -R typescript/generated/base-dna dist/base-dna",
    "build": "pnpm run clean && pnpm run sync-version && pnpm run build:dart && pnpm run build:ts",
    "clean": "rm -rf dist typescript/generated && mkdir -p typescript/generated",
    "test:dart": "dart test",
    "test:dart:browser": "dart test -p chrome -c dart2wasm test/main_test.dart",
    "test:vitest": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test": "pnpm run test:dart && pnpm run test:vitest && pnpm run lint",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.6.0",
    "jsdoc": "^4.0.5",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tssuite/gg_dna-js-bridge.git"
  },
  "homepage": "https://github.com/tssuite/gg_dna-js-bridge#readme",
  "bugs": {
    "url": "https://github.com/tssuite/gg_dna-js-bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Dr. Gabriel Gatzsche",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
