{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@tssuite/helix-js",

  // 1-2 sentence summary about this repo.
  "summary": "The helix DNA engine compiled to WebAssembly: instantiates and verifies the DNA of TypeScript projects. npm @tssuite/helix-js.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "DNA instantiation and verification for TypeScript",
    "helix engine core as wasm, file system and git injected from JS",
    "runDnaTest for Vitest",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "helix": "engine core, compiled with dart compile wasm",
      "dna_ggdna": "own DNA layer",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "dna-ts": "DNA engine, runDnaTest",
      "TypeScript repos": "runDnaTest in test/dna/dna.spec.ts",
    },
  },
}
